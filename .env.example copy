# Copy to ".env" (gitignored) and fill in. run.sh loads it automatically.
# Credentials are read from the environment only — never written to the repo,
# never logged, never placed in URLs. Odoo access is strictly read-only.

# ---- Connection (required for the live pull) ----
ODOO_BASE_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_LOGIN=buyer@yourcompany.com
ODOO_PASSWORD=changeme

# ---- Optional ----
ODOO_WAREHOUSE=US            # warehouse/location that is "US on-hand"
ODOO_SALES_MODEL=sale.report # sale.report (default) or fallback sale.order.line

# ---- Per-read cache (on-demand pulls; explicit refresh, never polled) ----
ODOO_CACHE_DIR=              # default: backend/data/odoo_cache
ODOO_CACHE_TTL_SECONDS=3600  # how long a cached read stays fresh (1h default)
ODOO_PAGE_SIZE=2000          # rows per paged read
ODOO_THROTTLE_SECONDS=0.2    # delay between calls to respect the instance

# ---- Background sync into the local cache DB (skubot pattern) ----
# run_sync.py snapshots Odoo into SQLite on this cadence; the app reads the
# cache. A failed/empty pull never overwrites the last good snapshot.
ODOO_SYNC_SECONDS=600        # snapshot cadence (10 min default)
ODOO_SYNC_STALE_FACTOR=2     # cache older than factor x interval => flagged stale
